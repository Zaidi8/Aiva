# LiveKit Cloud project (https://cloud.livekit.io)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Groq (STT + LLM) — https://console.groq.com/keys
GROQ_API_KEY=

# ElevenLabs (TTS) — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Aiva backend (Next.js app) — call-log + clinic-context webhooks POST here.
# Must point at your Vercel/PROD URL for deployed agents (localhost only works
# when the agent runs locally next to a dev server). Must match
# VOICE_WEBHOOK_SECRET in the root /Volumes/Dev/Aiva/.env.
AIVA_BACKEND_URL=https://aiva-fyp.vercel.app
AIVA_CLINIC_ID=
VOICE_WEBHOOK_SECRET=

# Optional tuning for the LLM + silence-escalation behavior.
# AIVA_PRIMARY_MODEL (default qwen/qwen3.8-27b)  — Groq LLM id for the primary
#   model. Must support tool calling.
# AIVA_FALLBACK_MODEL (default openai/gpt-oss-120b) — Groq LLM id used when the
#   primary returns 429 (mid-turn failover). Keep this a HIGH-capability model
#   that also supports tools: a weak fallback hallucinates mid-conversation.
#   NOTE: groq/compound has a bigger token budget but does NOT support tools,
#   and every free-tier tool-capable chat model is capped at 8,000 TPM.
# AIVA_SILENCE_TIMEOUT_S (default 7.0)         — seconds of silence before each
#                                                escalation step (no-speech dead air).
# AIVA_SILENCE_MAX_PROMPTS (default 2)         — prompts before a graceful hangup.
