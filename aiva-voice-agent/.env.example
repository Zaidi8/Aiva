# LiveKit Cloud project (https://cloud.livekit.io)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Groq (STT + LLM) — https://console.groq.com/keys
GROQ_API_KEY=

# ElevenLabs (TTS) — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Aiva backend (Next.js app) — clinic-context fetcher reads from here.
# Must match VOICE_WEBHOOK_SECRET in the root /Volumes/Dev/Aiva/.env.
AIVA_BACKEND_URL=http://localhost:3000
AIVA_CLINIC_ID=
VOICE_WEBHOOK_SECRET=
