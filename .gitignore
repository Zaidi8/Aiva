# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.playwright-mcp
/app/generated/prisma

# MCP server config — local-only
.mcp.json
.opencode/

# Audit screenshots and walkthrough artifacts
/audit-*.png
*.audit.png
/docs/audits/

# Internal planning / spec docs (kept locally)
/docs/superpowers/
/layout.md
/wireframes.md
/PROGRESS.md
/AUDIT_*.md
/HANDOFF*.md

# Local-only helper scripts (prefix with underscore)
/scripts/_*

# Local-only handoff context (kept on disk, not tracked)
/docs/handoff/
