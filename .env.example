# ──────────────────────────────────────────────────────────────────────────────
# Aiva — Environment Variables Template
# Copy this file to .env and fill in real values.
# Never commit .env to git (already covered by .gitignore's .env* rule).
# ──────────────────────────────────────────────────────────────────────────────

# Supabase project URL
# Found in: Supabase Dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key — safe for browser, RLS-gated
# Found in: Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase secret (service_role) key — SERVER ONLY, bypasses RLS
# Never expose to the browser. Used in server-side code that needs admin access.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Prisma — pooled connection (used by the app at runtime)
# Get from: Supabase Dashboard → Connect button → ORMs → Prisma
# Note the ?pgbouncer=true&connection_limit=1 — required for serverless
DATABASE_URL="postgres://postgres.your-project-ref:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Prisma — direct connection (used for migrations only)
# Get from: Supabase Dashboard → Connect button → Direct connection
DIRECT_URL="postgres://postgres.your-project-ref:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ──────────────────────────────────────────────────────────────────────────────
# AI receptionist — voice webhook auth
# ──────────────────────────────────────────────────────────────────────────────

# Shared secret with the voice provider. Sent on every webhook as the
# `X-Webhook-Secret` header. lib/api/with-webhook-secret.ts compares with
# crypto.timingSafeEqual. Fail-closed: if unset, all /api/voice/* return 401.
# Rotate by setting a new value here AND in the provider's webhook config.
VOICE_WEBHOOK_SECRET=
