// ─────────────────────────────────────────────────────────────────────────────
// Aiva — Prisma Schema
//
// Built from the data dictionary in the FYP documentation (§3.4.1) and the
// UI states defined in wireframes.md. Designed to be stack-agnostic at the
// data layer: the same schema serves the dashboard today and any future
// voice/AI integration (Retell, Twilio, self-hosted Whisper+Rasa) tomorrow.
//
// Conventions:
//   • cuid() over uuid() for primary keys (shorter, URL-safe, sortable)
//   • Soft single-clinic: one Clinic row holds clinic-level config and is
//     the parent of AiSettings. Multi-clinic later = add clinicId FKs.
//   • Supabase Auth lives in auth.users (Prisma can't manage it). We store
//     the Supabase user UUID on ClinicStaff.authUserId as the link.
//   • Double-booking is prevented at the DB level via a unique constraint
//     on (doctorId, scheduledAt). Race-safe, atomic.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Gender {
  Male
  Female
  Other
}

enum StaffRole {
  Admin
  Doctor
  Receptionist
}

enum AppointmentType {
  Checkup
  Consultation
  FollowUp
  Emergency
}

enum AppointmentStatus {
  Pending
  Confirmed
  Completed
  Cancelled
}

enum CallType {
  Booking
  Reschedule
  Cancellation
  Inquiry
}

enum CallOutcome {
  Completed     // resolved by AI
  Assisted      // AI helped, partial resolution
  Transferred   // escalated to human
  Failed        // call dropped or unresolvable
}

enum CallSentiment {
  Positive
  Neutral
  Negative
}

enum NotificationType {
  Confirmation
  Reminder
  Cancellation
  Reschedule
  System
}

enum NotificationStatus {
  Pending
  Sent
  Failed
}

enum NotificationChannel {
  SMS
  Push
  Email
}

// ─────────────────────────────────────────────────────────────────────────────
// CLINIC — single row in single-clinic deployments. Holds clinic-level config.
// ─────────────────────────────────────────────────────────────────────────────

model Clinic {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  // The inbound voice number assigned to this clinic. Distinct from `phone`
  // (staff contact) — `voicePhone` is what a patient dials, and the AI
  // receptionist runtime resolves a clinic from the inbound `to` number via
  // this field (must be unique).
  voicePhone String?  @unique @map("voice_phone")
  // IANA tz name. Source of truth for "9am means what" — drives all
  // appointment scheduling, schedule editor, and reminder dispatch logic.
  timezone  String   @default("Asia/Karachi") @map("timezone")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  staff        ClinicStaff[]
  doctors      Doctor[]
  patients     Patient[]
  appointments Appointment[]
  callLogs     CallLog[]
  aiSettings   AiSettings?
  invitations  StaffInvitation[]

  @@map("clinic")
}

// ─────────────────────────────────────────────────────────────────────────────
// CLINIC STAFF — dashboard users. Linked 1:1 to a Supabase auth.users row.
// authUserId is the Supabase user UUID; password lives in Supabase Auth, not here.
// ─────────────────────────────────────────────────────────────────────────────

model ClinicStaff {
  id            String    @id @default(cuid())
  authUserId    String    @unique @map("auth_user_id")
  fullName      String    @map("full_name")
  email         String    @unique
  role          StaffRole @default(Receptionist)
  phone         String?
  jobTitle      String?   @map("job_title") // e.g. "Practice Manager", "Lead Physician"
  deactivatedAt DateTime? @map("deactivated_at") // soft delete — getCurrentStaff filters these out
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  clinicId String @map("clinic_id")
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // The doctor row this staff member is linked to, if any. Set by Doctor.clinicStaffId.
  linkedDoctor    Doctor?
  sentInvitations StaffInvitation[]

  @@index([clinicId])
  @@map("clinic_staff")
}

// ─────────────────────────────────────────────────────────────────────────────
// PATIENT
// ─────────────────────────────────────────────────────────────────────────────

model Patient {
  id              String    @id @default(cuid())
  fullName        String    @map("full_name")
  age             Int?
  gender          Gender?
  phoneNumber     String    @map("phone_number")
  email           String?
  address         String?
  medicalHistory  String[]  @map("medical_history") // tagged conditions per data dictionary
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  clinicId String @map("clinic_id")
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  appointments Appointment[]
  callLogs     CallLog[]
  notifications Notification[]

  @@index([clinicId])
  @@index([phoneNumber]) // voice agent lookup by caller number
  @@map("patient")
}

// ─────────────────────────────────────────────────────────────────────────────
// DOCTOR
// availableSlots & workingHours kept as JSON per data dictionary; can be
// normalized to a dedicated Availability table later if scheduling logic grows.
// ─────────────────────────────────────────────────────────────────────────────

model Doctor {
  id             String   @id @default(cuid())
  name           String
  specialization String
  email          String?  @unique
  phone          String?
  // DEPRECATED: use DoctorSchedule and DoctorTimeOff. Will be dropped after Chat B migration.
  availableSlots Json?    @map("available_slots") // [{day, start, end}, ...]
  // DEPRECATED: use DoctorSchedule and DoctorTimeOff. Will be dropped after Chat B migration.
  workingHours   Json?    @map("working_hours")   // {mon: {start, end}, ...}
  deactivatedAt  DateTime? @map("deactivated_at") // soft delete
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  clinicId String @map("clinic_id")
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // Optional link to a ClinicStaff login user. Doctor rows can exist without
  // a login (clinic-managed); when a doctor logs in to the dashboard themselves
  // we link them via this FK. SetNull so deleting the staff doesn't nuke the doctor.
  clinicStaffId String?      @unique @map("clinic_staff_id")
  clinicStaff   ClinicStaff? @relation(fields: [clinicStaffId], references: [id], onDelete: SetNull)

  appointments Appointment[]
  schedules    DoctorSchedule[]
  timeOff      DoctorTimeOff[]

  @@index([clinicId])
  @@map("doctor")
}

// ─────────────────────────────────────────────────────────────────────────────
// APPOINTMENT
// Combined date+time into a single scheduledAt timestamp — easier for queries,
// timezone-correct, and lets us put the unique double-booking constraint on it.
// ─────────────────────────────────────────────────────────────────────────────

model Appointment {
  id           String            @id @default(cuid())
  scheduledAt  DateTime          @map("scheduled_at")
  durationMin  Int               @default(30) @map("duration_min")
  type         AppointmentType
  status       AppointmentStatus @default(Pending)
  notes        String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  patientId String  @map("patient_id")
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId String @map("doctor_id")
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  clinicId String @map("clinic_id")
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  notifications Notification[]
  callLogs      CallLog[]

  // DB-level double-booking prevention. Atomic, race-safe.
  @@unique([doctorId, scheduledAt], name: "doctor_slot_unique")
  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId, scheduledAt])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointment")
}

// ─────────────────────────────────────────────────────────────────────────────
// CALL LOG — every voice interaction with the AI receptionist.
// patientId is nullable so unknown-caller logs still get recorded.
// appointmentId links the call to the resulting booking, if any.
// ─────────────────────────────────────────────────────────────────────────────

model CallLog {
  id              String         @id @default(cuid())
  patientPhone    String         @map("patient_phone")
  durationSec     Int            @default(0) @map("duration_sec")
  detectedIntent  CallType?      @map("detected_intent")
  outcome         CallOutcome    @default(Failed)
  transcript      Json?          // [{role, text, timestamp}, ...]
  sentiment       CallSentiment?
  qualityRating   Int?           @map("quality_rating") // 1-5
  recordingUrl    String?        @map("recording_url")
  startedAt       DateTime       @map("started_at")
  endedAt         DateTime?      @map("ended_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Required tenant key. Resolved by the inbound-call webhook from the
  // `to` number (Clinic.voicePhone @unique).
  clinicId String @map("clinic_id")
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  patientId String?  @map("patient_id")
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  appointmentId String?      @map("appointment_id")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  // The voice provider's call id. Lets the runtime correlate webhook events
  // without us inventing our own id, and gives an idempotency anchor.
  providerCallId String? @unique @map("provider_call_id")

  @@index([clinicId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([patientPhone])
  @@index([startedAt])
  @@index([outcome])
  @@map("call_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATION — confirmations, reminders, cancellation alerts.
// Channel-agnostic at the data layer (SMS/push/email — provider plugs in later).
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  type      NotificationType
  channel   NotificationChannel
  status    NotificationStatus  @default(Pending)
  message   String
  sentAt    DateTime?           @map("sent_at")
  errorMsg  String?             @map("error_msg")
  createdAt DateTime            @default(now()) @map("created_at")

  patientId String  @map("patient_id")
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  appointmentId String?      @map("appointment_id")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([appointmentId])
  @@index([status])
  @@map("notification")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI SETTINGS — singleton config for the AI receptionist agent.
// 1:1 with Clinic. Maps to the Settings → AI tab in the dashboard.
// ─────────────────────────────────────────────────────────────────────────────

model AiSettings {
  id                   String   @id @default(cuid())
  agentName            String   @default("Aiva") @map("agent_name")
  greetingMessage      String   @default("Hello! Thank you for calling. How may I help you today?") @map("greeting_message")
  autoBook             Boolean  @default(true) @map("auto_book")
  sendConfirmations    Boolean  @default(true) @map("send_confirmations")
  handleRescheduling   Boolean  @default(true) @map("handle_rescheduling")
  emergencyTransfer    Boolean  @default(true) @map("emergency_transfer")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  clinicId String @unique @map("clinic_id")
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// DOCTOR SCHEDULE — recurring weekly availability per doctor.
// One row per (doctor, dayOfWeek). slotDurationMinutes drives how the
// scheduler bucketizes the start/end window into bookable slots.
// ─────────────────────────────────────────────────────────────────────────────

model DoctorSchedule {
  id                  String   @id @default(cuid())
  dayOfWeek           Int      @map("day_of_week")           // 0 = Sunday … 6 = Saturday
  startTime           String   @map("start_time")            // "HH:mm" in clinic timezone
  endTime             String   @map("end_time")              // "HH:mm" in clinic timezone
  slotDurationMinutes Int      @default(30) @map("slot_duration_minutes")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  doctorId String @map("doctor_id")
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
  @@index([doctorId])
  @@map("doctor_schedule")
}

// ─────────────────────────────────────────────────────────────────────────────
// DOCTOR TIME OFF — date-range overrides on top of the recurring schedule
// (vacation, sick days, conferences). Inclusive dates.
// ─────────────────────────────────────────────────────────────────────────────

model DoctorTimeOff {
  id        String   @id @default(cuid())
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  doctorId String @map("doctor_id")
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([startDate, endDate])
  @@map("doctor_time_off")
}

// ─────────────────────────────────────────────────────────────────────────────
// STAFF INVITATION — pending invites from an admin to a new staff member.
// `token` is the opaque single-use link recipient receives by email.
// `acceptedAt` flips when they complete signup; the (clinicId, email) unique
// constraint is intentionally not partial — to re-invite, delete the old row.
// ─────────────────────────────────────────────────────────────────────────────

model StaffInvitation {
  id         String    @id @default(cuid())
  email      String
  fullName   String    @map("full_name")
  role       StaffRole
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  clinicId String @map("clinic_id")
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  invitedByStaffId String?      @map("invited_by_staff_id")
  invitedByStaff   ClinicStaff? @relation(fields: [invitedByStaffId], references: [id], onDelete: SetNull)

  @@unique([clinicId, email])
  @@index([token])
  @@map("staff_invitation")
}

// ─────────────────────────────────────────────────────────────────────────────
// WEBHOOK EVENT — idempotency log for inbound webhooks (voice provider et al).
// Providers RETRY on flaky responses; we look up by `providerEventId` and
// short-circuit if `processedAt` is already set. `payload` captures the raw
// body for replay / debugging. `error` captures the failure message so the
// next retry knows whether to try again.
// ─────────────────────────────────────────────────────────────────────────────

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String                                            // "voice", "sms", etc.
  providerEventId String   @unique @map("provider_event_id")
  eventType       String   @map("event_type")                       // "call.started", "call.ended", ...
  payload         Json
  receivedAt      DateTime @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")
  error           String?

  @@index([provider, eventType])
  @@index([receivedAt])
  @@map("webhook_event")
}
